---
// D4 · small line icons for the Deep Dives tracks (replace the emoji on the site; Telegram keeps emoji).
interface Props {
	track: string;
	size?: number;
}
const { track, size = 14 } = Astro.props;
const paths: Record<string, string> = {
	'models-agentic': 'M12 3l2.2 5.4L20 10l-5.8 1.6L12 17l-2.2-5.4L4 10l5.8-1.6z M19 16l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z',
	research: 'M9 3h6 M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3 M7.5 15h9',
	system: 'M12 3l9 5-9 5-9-5z M3 13l9 5 9-5 M3 17.5l9 5 9-5',
	interview: 'M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12z M9 11h.01 M12 11h.01 M15 11h.01',
	github: 'M6 3v12 M6 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M18 9a9 9 0 0 1-9 9',
	build: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z',
	lab: 'M10 2v7.3L4.5 19A2 2 0 0 0 6.2 22h11.6a2 2 0 0 0 1.7-3L14 9.3V2 M8.5 2h7 M7 16h10',
	recap: 'M3 12a9 9 0 0 1 15.5-6.3L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-15.5 6.3L3 16 M3 21v-5h5',
	radar: 'M22 10L12 5 2 10l10 5 10-5z M6 12v5c3 2.5 9 2.5 12 0v-5',
};
const d = paths[track] ?? paths.system;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
	<path d={d}></path>
</svg>
