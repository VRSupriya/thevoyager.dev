---
// The Voyager mark: a small craft on a tilted orbit.
const { size = 26 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
	<ellipse cx="16" cy="16" rx="13" ry="6.5" transform="rotate(-28 16 16)" stroke="var(--accent)" stroke-width="1.6" opacity="0.85"></ellipse>
	<circle cx="16" cy="16" r="4.2" fill="currentColor"></circle>
	<circle cx="26.3" cy="9.6" r="2.2" fill="var(--accent)"></circle>
</svg>
