---
import { LINKS, SITE_NAME } from '../consts';
import SubstackFrame from './SubstackFrame.astro';

interface Props {
	showNewsletter?: boolean;
}
const { showNewsletter = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		{
			showNewsletter && (
				<div class="signup">
					<p>
						<strong>The weekly note.</strong> My own writing, once a week. Never the daily AI digests.
					</p>
					<SubstackFrame />
				</div>
			)
		}
		<div class="bottom">
			<p>© {year} {SITE_NAME}</p>
			<ul>
				<li><a href={LINKS.github}>GitHub</a></li>
				<li><a href={LINKS.substack}>Substack</a></li>
				<li><a href="/brief/rss.xml">RSS</a></li>
				<li><a href="/privacy/">Privacy</a></li>
				<li><a href="/disclosure/">Disclosure</a></li>
			</ul>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		padding: 2rem 0 2.5rem;
		font-size: 0.9rem;
		color: var(--muted);
	}
	.signup {
		display: grid;
		gap: 0.9rem;
		align-items: center;
		padding-bottom: 1.6rem;
		margin-bottom: 1.4rem;
		border-bottom: 1px solid var(--border);
	}
	.signup p {
		margin: 0;
	}
	.signup strong {
		color: var(--text);
	}
	@media (min-width: 800px) {
		.signup {
			grid-template-columns: 1fr auto;
		}
		.bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.6rem 1.5rem;
	}
	.bottom p {
		margin: 0;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--text);
	}
</style>
