---
import { render } from 'astro:content';
import Post from '../../../layouts/Post.astro';
import { getTrack } from '../../../consts';
import { type Dive, hasMermaid, getDives, slugOf } from '../../../lib/posts';

export async function getStaticPaths() {
	const posts = await getDives();
	return posts.map((post) => ({
		params: { track: post.data.track, slug: slugOf(post.id) },
		props: post,
	}));
}

const post = Astro.props as Dive;
const { Content } = await render(post);
const track = getTrack(post.data.track);
const time =
	post.data.time_minutes >= 60
		? `${+(post.data.time_minutes / 60).toFixed(1)} h`
		: `${post.data.time_minutes} min`;
---

<Post
	title={post.data.title}
	date={post.data.date}
	summary={post.data.summary}
	tags={post.data.tags}
	section="🔭 Deep Dives"
	sectionHref="/deep-dives/"
	label={`${track.emoji} ${track.label}`}
	labelHref={`/deep-dives/${track.slug}/`}
	extra={[`⏱ ${time}`]}
	curated={post.data.curated_with_ai}
	hasMermaid={hasMermaid(post.body)}
>
	<Content />
</Post>
