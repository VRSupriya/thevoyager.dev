---
import { render } from 'astro:content';
import Post from '../../../layouts/Post.astro';
import { getTrack } from '../../../consts';
import { loadCurriculum } from '../../../lib/curriculum';
import { type Dive, diveLink, diveTime, diveUrl, getDives, neighbours, relatedDives, seriesParts, slugOf } from '../../../lib/posts';

export async function getStaticPaths() {
	const posts = await getDives();
	return posts.map((post) => ({
		params: { track: post.data.track, slug: slugOf(post.id) },
		props: post,
	}));
}

const post = Astro.props as Dive;
const { Content, headings, remarkPluginFrontmatter: fm } = await render(post);
const track = getTrack(post.data.track);
const all = await getDives();
const inTrack = all.filter((d) => d.data.track === post.data.track);
const { newer, older } = neighbours(inTrack, post);
const parts = seriesParts(all, post.data.series);
const { modules } = loadCurriculum();
const cw = modules.flatMap((m) => m.weeks).find((w) => w.week === post.data.week);
const courseTheme = cw?.theme ?? (cw?.review ? 'Review week' : undefined);
const courseLink = courseTheme && post.data.track !== 'lab' ? { label: `Week ${post.data.week} · ${courseTheme}`, href: '/deep-dives/curriculum/' } : undefined;
const related = relatedDives(post, all, 2).filter((d) => !parts.includes(d)).map((d) => diveLink(d));
---

<Post
	title={post.data.title}
	date={post.data.date}
	summary={post.data.summary}
	corrections={post.data.corrections}
	tags={post.data.tags}
	section="Deep Dives"
	sectionHref="/deep-dives/"
	label={track.label}
	labelHref={`/deep-dives/${track.slug}/`}
	track={track.slug}
	cover={post.id}
	extra={[diveTime(post.data)]}
	courseLink={courseLink}
	takeaways={post.data.takeaways}
	headings={headings}
	series={parts.length > 1 ? {
		name: post.data.series!,
		parts: parts.map((p) => ({ href: diveUrl(p), title: p.data.title, current: p.id === post.id })),
	} : undefined}
	shareKind="dive"
	shareWritten={post.data.share ?? post.data.linkedin}
	shareTelegram={post.data.telegram}
	hasMermaid={fm.hasMermaid}
	interactive={fm.interactive}
	related={related}
	prev={older && diveLink(older, `Previous in ${track.label}`)}
	next={newer && diveLink(newer, `Next in ${track.label}`)}
	image={`/og/dives/${post.id}.png`}
	aiNote
>
	<Content />
</Post>
