---
import SignupForm from './SignupForm.astro';

interface Props {
	heading?: string;
	text?: string;
	id?: string;
}
const {
	heading = 'The weekly note',
	text = 'Once a week, in my own words: what I learned, what I built, and the best of the blog. Never the daily AI digests.',
	id = 'newsletter',
} = Astro.props;
---

<section class="newsletter" aria-labelledby={`${id}-heading`}>
	<p class="eyebrow">Newsletter</p>
	<h2 id={`${id}-heading`}>{heading}</h2>
	<p class="lede">{text}</p>
	<SignupForm id={`${id}-email`} />
</section>

<style>
	.newsletter {
		max-width: var(--measure);
		margin: 3rem auto 0;
		padding: 1.4rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}
	h2 {
		margin: 0 0 0.4rem;
		font-size: 1.3rem;
	}
	.lede {
		color: var(--muted);
		margin: 0 0 1rem;
	}
</style>
