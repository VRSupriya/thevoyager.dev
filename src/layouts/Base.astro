---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ADSENSE_CLIENT, SITE_DESCRIPTION, SITE_NAME, SITE_TITLE } from '../consts';

interface Props {
	/** Page name; becomes "<title> · The Voyager". Leave empty for the full site title. */
	title?: string;
	description?: string;
	/** true for AI-curated posts: keep them out of search engines but follow their links. */
	noindex?: boolean;
	/** Hide the footer sign-up when the page already shows the newsletter box. */
	hideFooterNewsletter?: boolean;
	ogType?: 'website' | 'article';
	/** Preview image for shared links: a path like /og-default.png. */
	image?: string;
}

const {
	title,
	description = SITE_DESCRIPTION,
	noindex = false,
	hideFooterNewsletter = false,
	ogType = 'website',
	image = '/og-default.png',
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title="The Voyager · Daily Brief" href="/brief/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title="The Voyager · Deep Dives" href="/deep-dives/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title="The Voyager · Writing" href="/writing/rss.xml" />
		<meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)" />
		<meta name="generator" content={Astro.generator} />
		{
			ADSENSE_CLIENT && (
				<script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" />
			)
		}

		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="The Voyager: exploring the frontier, building what's next" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={imageURL} />

		<Font cssVariable="--font-atkinson" preload />

		<!-- Apply the saved theme before the first paint, so there's no flash. -->
		<script is:inline>
			try {
				const t = localStorage.getItem('theme');
				if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
			} catch (e) {}
		</script>
	</head>
	<body>
		<a class="sr-only" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<div class="wrap">
				<slot />
			</div>
		</main>
		<Footer showNewsletter={!hideFooterNewsletter} />
	</body>
</html>
