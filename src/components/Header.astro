---
import { NAV, SITE_NAME } from '../consts';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<div class="wrap bar">
		<a class="brand" href="/" aria-label={`${SITE_NAME}, home`}>
			<Logo />
			<span>{SITE_NAME}</span>
		</a>
		<nav aria-label="Main">
			<ul>
				{
					NAV.map((item) => (
						<li>
							<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="actions">
			<a class="icon-btn" href="/search/" aria-label="Search" title="Search">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
			</a>
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	.bar {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas: 'brand actions' 'nav nav';
		align-items: center;
		padding-top: 0.6rem;
	}
	.brand {
		grid-area: brand;
	}
	nav {
		grid-area: nav;
		min-width: 0;
	}
	.actions {
		grid-area: actions;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
		font-size: 1.08rem;
		letter-spacing: 0.01em;
	}
	.actions {
		display: flex;
		justify-self: end;
		gap: 0.25rem;
	}
	nav ul {
		display: flex;
		gap: 0.2rem;
		list-style: none;
		margin: 0;
		padding: 0.35rem 0 0.5rem;
		overflow-x: auto;
		scrollbar-width: none;
	}
	nav ul::-webkit-scrollbar {
		display: none;
	}
	nav a {
		display: block;
		white-space: nowrap;
		padding: 0.3rem 0.7rem;
		border-radius: 8px;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
	}
	nav a:hover {
		color: var(--text);
		background: var(--surface-2);
	}
	nav a[aria-current='page'] {
		color: var(--text);
		font-weight: 700;
		box-shadow: inset 0 -2px 0 var(--accent);
		border-radius: 8px 8px 0 0;
	}
	@media (min-width: 900px) {
		.bar {
			grid-template-columns: auto 1fr auto;
			grid-template-areas: 'brand nav actions';
			gap: 1.5rem;
			padding: 0.4rem 1.1rem;
		}
		nav ul {
			justify-content: center;
			padding: 0.4rem 0;
		}
	}
	.icon-btn {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 8px;
		color: var(--muted);
	}
	.icon-btn:hover {
		color: var(--text);
		background: var(--surface-2);
	}
</style>
