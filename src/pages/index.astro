---
import Base from '../layouts/Base.astro';
import DiveCard from '../components/DiveCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Newsletter from '../components/Newsletter.astro';
import WeekStrip from '../components/WeekStrip.astro';
import { SITE_TAGLINE } from '../consts';
import { briefStories } from '../lib/brief';
import { briefUrl, dayKey, getBriefs, getDives, getWriting, todayKey, writingUrl } from '../lib/posts';

const today = todayKey();
const briefs = await getBriefs();
const dives = await getDives();
const writing = (await getWriting()).filter((p) => !p.data.draft).slice(0, 3);

// Today's post if there is one, otherwise the latest.
const brief = briefs.find((p) => dayKey(p.data.date) === today) ?? briefs[0];
const topic = dives.find((p) => dayKey(p.data.date) === today) ?? dives[0];
const isToday = (p?: { data: { date: Date } }) => !!p && dayKey(p.data.date) === today;
const stories = brief ? briefStories(brief.body, brief.data.telegram) : [];
const recent = dives.filter((d) => d !== topic).slice(0, 4);
const todayLabel = new Date(`${today}T00:00:00Z`).toLocaleDateString('en-GB', {
	weekday: 'long',
	day: 'numeric',
	month: 'long',
	timeZone: 'UTC',
});
---

<Base hideFooterNewsletter>
	<section class="intro">
		<p class="eyebrow">{todayLabel}</p>
		<h1>{SITE_TAGLINE}</h1>
		<p class="lede">
			A daily AI brief and one deep dive a day, written for senior engineers and architects. <a href="/start/">New here? Start here →</a>
		</p>
	</section>

	<section class="today" aria-label="Today">
		{
			brief ? (
				<article class="card brief-card">
					<p class="kicker">{isToday(brief) ? "Today's brief" : 'Latest brief'} · <FormattedDate date={brief.data.date} /></p>
					<h2 class="bc-title"><a href={briefUrl(brief)}>{brief.data.title}</a></h2>
					{stories.length > 0 && (
						<ol class="bc-stories">
							{stories.map((s) => (
								<li class={`slot-${s.key}`}>
									<a href={`${briefUrl(brief)}#${s.anchor}`}>
										<span class="bc-label">{s.label}</span>
										<span class="bc-line">{s.line}</span>
										{s.source && <span class="bc-src">{s.source}</span>}
									</a>
								</li>
							))}
						</ol>
					)}
					<a class="bc-more" href={briefUrl(brief)}>Read the brief →</a>
				</article>
			) : (
				<div class="card placeholder">
					<p class="kicker">Daily Brief</p>
					<p>The first brief lands soon.</p>
				</div>
			)
		}
		{
			topic ? (
				<DiveCard post={topic} kicker={isToday(topic) ? "Today's deep dive" : 'Latest deep dive'} showTakeaways showCover headingLevel="h2" />
			) : (
				<div class="card placeholder">
					<p class="kicker">Deep Dives</p>
					<p>The first deep dive lands soon.</p>
				</div>
			)
		}
	</section>

	<section class="block" aria-labelledby="week-heading">
		<div class="section-head">
			<h2 id="week-heading">This week</h2>
			<a href="/brief/">All briefs →</a>
		</div>
		<WeekStrip today={today} briefs={briefs} dives={dives} />
	</section>

	{
		recent.length > 0 && (
			<section class="block" aria-labelledby="recent-heading">
				<div class="section-head">
					<h2 id="recent-heading">Recent deep dives</h2>
					<a href="/deep-dives/">All deep dives →</a>
				</div>
				<ul class="card-grid wide">
					{recent.map((p) => (
						<li>
							<DiveCard post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		writing.length > 0 && (
			<section class="block" aria-labelledby="writing-heading">
				<div class="section-head">
					<h2 id="writing-heading">From the author</h2>
					<a href="/writing/">All writing →</a>
				</div>
				<ul class="post-list wide">
					{writing.map((p) => (
						<li>
							<a class="card" href={writingUrl(p)}>
								<div class="meta"><FormattedDate date={p.data.date} /></div>
								<h3>{p.data.title}</h3>
								<p>{p.data.summary}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<Newsletter />
</Base>

<style>
	.intro,
	.today,
	.block {
		max-width: var(--measure);
		margin: 0 auto;
	}
	@media (min-width: 900px) {
		.intro,
		.today,
		.block,
		.wide {
			max-width: 60rem;
		}
		.today {
			grid-template-columns: 1.1fr 1fr;
		}
	}
	.intro {
		padding: 1rem 0 0.4rem;
		margin-bottom: 1.6rem;
	}
	.intro h1 {
		font-size: clamp(1.7rem, 5vw, 2.4rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 0.6rem;
	}
	.lede {
		font-size: 1.05rem;
		color: var(--muted);
		margin: 0;
	}
	.today {
		display: grid;
		gap: 0.9rem;
	}
	.kicker {
		margin: 0 0 0.3rem;
		font-family: var(--font-head);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.brief-card {
		display: flex;
		flex-direction: column;
		border-top: 3px solid var(--accent);
	}
	.bc-title {
		font-size: 1.3rem;
		line-height: 1.25;
		margin: 0.1rem 0 0.8rem;
	}
	.bc-title a {
		color: var(--text);
		text-decoration: none;
	}
	.bc-title a:hover {
		color: var(--accent);
	}
	.bc-stories {
		list-style: none;
		margin: 0 0 0.8rem;
		padding: 0;
		display: grid;
	}
	.bc-stories a {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0 0.6rem;
		padding: 0.5rem 0;
		border-top: 1px solid var(--border);
		text-decoration: none;
		color: var(--text);
		line-height: 1.35;
	}
	.bc-stories a:hover .bc-line {
		color: var(--accent);
	}
	.bc-label {
		grid-column: 1 / -1;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--slot, var(--accent));
	}
	.bc-src {
		font-size: 0.78rem;
		color: var(--muted);
		align-self: end;
	}
	.bc-more {
		margin-top: auto;
		font-weight: 700;
		font-size: 0.95rem;
	}
	.placeholder {
		color: var(--muted);
		border-style: dashed;
		box-shadow: none;
	}
	.block {
		margin-top: 2.8rem;
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 0.9rem;
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.2rem;
	}
	.section-head a {
		font-size: 0.9rem;
	}
	.block .card-grid,
	.block .post-list {
		max-width: none;
	}
</style>
