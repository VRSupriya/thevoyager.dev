---
// P7 · a Deep Dive in a list: track colour and icon, series, time, and (optionally) the takeaways.
import FormattedDate from './FormattedDate.astro';
import TrackIcon from './TrackIcon.astro';
import CoverArt from './CoverArt.astro';
import { getTrack } from '../consts';
import { type Dive, diveTime, diveUrl } from '../lib/posts';

interface Props {
	post: Dive;
	/** Kicker text instead of the track name, e.g. "Today's deep dive". */
	kicker?: string;
	showTakeaways?: boolean;
	showCover?: boolean;
	headingLevel?: 'h2' | 'h3';
}
const { post, kicker, showTakeaways = false, showCover = false, headingLevel = 'h3' } = Astro.props;
const t = getTrack(post.data.track);
const H = headingLevel;
---

<article class="card dive-card" data-track={post.data.track}>
	{showCover && <CoverArt seed={post.id} width={720} height={140} class="dive-cover" />}
	<p class="dc-kicker">
		<TrackIcon track={post.data.track} />
		<span>{kicker ? `${kicker} · ${t.label}` : t.label}</span>
		{post.data.series && <span class="dc-series">{post.data.series}{post.data.part ? `, part ${post.data.part}` : ''}</span>}
	</p>
	<H class="dc-title"><a href={diveUrl(post)}>{post.data.title}</a></H>
	<p class="dc-summary">{post.data.summary}</p>
	{
		showTakeaways && post.data.takeaways.length > 0 && (
			<ul class="dc-takeaways">
				{post.data.takeaways.map((x) => (
					<li>{x}</li>
				))}
			</ul>
		)
	}
	<div class="meta">
		<FormattedDate date={post.data.date} />
		<span>{diveTime(post.data)}</span>
	</div>
</article>

<style>
	.dive-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		border-top: 3px solid var(--track);
		height: 100%;
	}
	.dive-card:hover {
		border-color: var(--track);
	}
	.dive-card :global(.dive-cover) {
		margin: -0.3rem -0.4rem 0.5rem;
	}
	.dc-kicker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		font-family: var(--font-head);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--track);
	}
	.dc-series {
		color: var(--muted);
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: none;
	}
	.dc-series::before {
		content: '· ';
	}
	.dc-title {
		margin: 0.1rem 0 0.15rem;
		font-size: 1.15rem;
		line-height: 1.3;
	}
	.dc-title a {
		color: var(--text);
		text-decoration: none;
	}
	.dc-title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.dc-summary {
		margin: 0;
		color: var(--muted);
	}
	.dc-takeaways {
		margin: 0.4rem 0 0;
		padding-left: 1.1rem;
		font-size: 0.93rem;
	}
	.dc-takeaways li {
		margin-bottom: 0.25rem;
	}
	.dc-takeaways li::marker {
		color: var(--track);
	}
	.dive-card .meta {
		margin-top: auto;
		padding-top: 0.6rem;
	}
</style>
