			</li>
		</ul>
	</article>
</Base>

<style>
	.todo {
		padding: 0.8rem 1rem;
		border: 1px dashed var(--amber);
		border-radius: 10px;
		color: var(--muted);
		background: var(--amber-soft);
	}
	li .todo {
		display: inline-block;
		padding: 0.1rem 0.5rem;
	}
</style>
