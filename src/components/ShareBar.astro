---
import { buildShare, type ShareInput } from '../lib/share';

interface Props extends Omit<ShareInput, 'url'> {}
const input = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const s = buildShare({ ...input, url });
const enc = encodeURIComponent;

// Markdown copy for Notion, docs and READMEs.
const markdown = s.long
	.split('\n')
	.map((l, i) => (i === 0 ? `## ${l}` : l.startsWith('• ') ? `- ${l.slice(2)}` : l))
	.join('\n')
	.replace(/(?:Full post and sources:|Read the full post:)\n(\S+)/, '[Read the full post]($1)');

// Plain links: they work even without JavaScript. Icons are filled brand glyphs (24 x 24).
const links = [
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/feed/',
		copy: 'Copied. Paste it into your LinkedIn post.',
		path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
	},
	{
		label: 'X',
		href: `https://twitter.com/intent/tweet?text=${enc(s.short)}&url=${enc(url)}`,
		path: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932zm-1.29 19.494h2.039L6.486 3.24H4.298z',
	},
	{
		label: 'Bluesky',
		href: `https://bsky.app/intent/compose?text=${enc(s.shortWithLink)}`,
		path: 'M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z',
	},
	{
		label: 'Email',
		href: `mailto:?subject=${enc(s.title)}&body=${enc(s.long)}`,
		stroke: true,
		path: 'M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5zM3.5 7l8.5 6 8.5-6',
	},
];
---

<section class="share" data-pagefind-ignore data-share data-title={s.title} data-url={url}>
	<details class="pop">
		<summary class="trigger" aria-label="Share this post">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="M12 16V4"/><path d="m7.5 8.5 4.5-4.5 4.5 4.5"/></svg>
			Share
		</summary>
		<div class="panel" role="group" aria-label="Share options">
			<pre class="text" data-text tabindex="0">{s.long}</pre>
			<div class="icons" role="group" aria-label="Share to">
				{links.map((l) => (
					<a class="icon" href={l.href} target="_blank" rel="noopener" aria-label={l.label} title={l.label} data-copy={l.copy ? '' : undefined} data-after={l.copy}>
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill={l.stroke ? 'none' : 'currentColor'} stroke={l.stroke ? 'currentColor' : 'none'} stroke-width="1.7" stroke-linejoin="round"><path d={l.path} /></svg>
					</a>
				))}
				<button class="icon" type="button" data-native aria-label="More apps" title="More apps" hidden>
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><circle cx="5.5" cy="12" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="18.5" cy="12" r="1.8" /></svg>
				</button>
			</div>
			<ul>
				<li><button type="button" data-copy data-after="Text copied.">Copy text<small>Title, points, link and hashtags</small></button></li>
				<li><button type="button" data-copy-md data-after="Markdown copied.">Copy as Markdown<small>For Notion, docs or a README</small></button></li>
				<li><button type="button" data-copy-link>Copy link<small>Just the address</small></button></li>
			</ul>
			<p class="status" role="status" aria-live="polite"></p>
			<template data-md>{markdown}</template>
		</div>
	</details>
</section>

<script>
	async function copy(text: string): Promise<boolean> {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			const ta = document.createElement('textarea');
			ta.value = text;
			ta.style.position = 'fixed';
			ta.style.opacity = '0';
			document.body.appendChild(ta);
			ta.select();
			let ok = false;
			try {
				ok = document.execCommand('copy');
			} catch {}
			ta.remove();
			return ok;
		}
	}

	document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
		const text = root.querySelector('[data-text]')?.textContent ?? '';
		const md = root.querySelector('template[data-md]')?.textContent ?? text;
		const pop = root.querySelector<HTMLDetailsElement>('.pop')!;
		const status = root.querySelector<HTMLElement>('.status');
		const say = (msg: string) => {
			if (status) status.textContent = msg;
		};
		const fail = 'Could not copy. Select the text above and copy it by hand.';

		root.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
			el.addEventListener('click', async () => {
				say((await copy(text)) ? (el.dataset.after ?? 'Copied.') : fail);
			});
		});
		root.querySelector<HTMLElement>('[data-copy-md]')?.addEventListener('click', async () => {
			say((await copy(md)) ? 'Markdown copied.' : fail);
		});
		root.querySelector('[data-copy-link]')?.addEventListener('click', async () => {
			say((await copy(root.dataset.url ?? '')) ? 'Link copied.' : 'Could not copy the link.');
		});

		// Where the browser supports it, offer the system share sheet: every app installed on the device shows up there.
		const native = root.querySelector<HTMLElement>('[data-native]');
		if (native && typeof navigator.share === 'function') {
			native.hidden = false;
			native.addEventListener('click', async () => {
				try {
					await navigator.share({ title: root.dataset.title, text, url: root.dataset.url });
				} catch {}
			});
		}

		document.addEventListener('click', (e) => {
			if (pop.open && !root.contains(e.target as Node)) pop.open = false;
		});
		pop.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && pop.open) {
				pop.open = false;
				pop.querySelector('summary')?.focus();
			}
		});
		pop.addEventListener('toggle', () => {
			if (!pop.open) say('');
			else root.querySelector('.panel')?.scrollIntoView({ block: 'center', behavior: 'smooth' });
		});
	});
</script>

<style>
	.share {
		max-width: var(--measure);
		margin: 2.5rem 0 0;
		padding-top: 1.4rem;
		border-top: 1px solid var(--border);
	}
	.pop {
		position: relative;
		width: fit-content;
	}
	.trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.5rem;
		padding: 0 1.1rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text);
		font-size: 0.95rem;
		cursor: pointer;
		list-style: none;
	}
	.trigger::-webkit-details-marker {
		display: none;
	}
	.trigger:hover,
	.pop[open] .trigger {
		border-color: var(--accent);
		color: var(--accent);
	}
	.trigger:focus-visible,
	.panel a:focus-visible,
	.panel button:focus-visible,
	.text:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.panel {
		position: absolute;
		z-index: 5;
		bottom: calc(100% + 0.5rem);
		left: 0;
		width: min(24rem, calc(100vw - 2rem));
		padding: 0.6rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--shadow);
	}
	.text {
		max-height: 6rem;
		overflow: auto;
		margin: 0 0 0.5rem;
		padding: 0.7rem 0.8rem;
		white-space: pre-wrap;
		word-break: break-word;
		border-radius: 8px;
		background: var(--bg);
		color: var(--muted);
		font: inherit;
		font-size: 0.8rem;
		line-height: 1.5;
	}
	.icons {
		display: flex;
		gap: 0.5rem;
		padding: 0.2rem 0.3rem 0.6rem;
	}
	.panel .icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: none;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: none;
		color: var(--text);
		cursor: pointer;
	}
	.panel .icon[hidden] {
		display: none;
	}
	.panel .icon:hover {
		border-color: var(--accent);
	}
	ul {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li[hidden] {
		display: none;
	}
	.panel li a,
	.panel li button {
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		width: 100%;
		padding: 0.4rem 0.7rem;
		border: 0;
		border-radius: 8px;
		background: none;
		color: var(--text);
		font: inherit;
		font-size: 0.95rem;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}
	.panel small {
		color: var(--muted);
		font-size: 0.78rem;
	}
	.panel li a:hover,
	.panel li button:hover {
		background: var(--accent-soft);
		color: var(--accent);
	}
	.status {
		min-height: 1.3em;
		margin: 0.3rem 0.7rem 0.1rem;
		font-size: 0.85rem;
		color: var(--accent);
	}
	@media (max-width: 600px) {
		.text,
		.panel small {
			display: none;
		}
		.panel li a,
		.panel li button {
			padding: 0.65rem 0.7rem;
		}
	}
</style>
