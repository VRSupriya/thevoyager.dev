---
import Base from '../../layouts/Base.astro';
import TrackIcon from '../../components/TrackIcon.astro';
import { getTrack } from '../../consts';
import { loadCurriculum } from '../../lib/curriculum';
import { diveUrl, getDives } from '../../lib/posts';

const { modules, currentWeek } = loadCurriculum();
const dives = await getDives();
const order = ['models-agentic', 'research', 'system', 'interview', 'github', 'build', 'lab', 'recap', 'radar'];
const postsIn = (week: number) =>
	dives.filter((d) => d.data.week === week).sort((a, b) => order.indexOf(a.data.track) - order.indexOf(b.data.track));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const state = (w: number) => (w < currentWeek ? 'past' : w === currentWeek ? 'now' : 'next');
const moduleState = (m: { weeks: { week: number }[] }) => {
	const first = m.weeks[0].week;
	const last = m.weeks[m.weeks.length - 1].week;
	return currentWeek > last ? 'past' : currentWeek >= first ? 'now' : 'next';
};
const totalWeeks = Math.max(...modules.flatMap((m) => m.weeks.map((w) => w.week)));
const progress = Math.min(100, Math.max(0, Math.round(((currentWeek - 1) / totalWeeks) * 100)));
---

<Base title="Curriculum · Deep Dives" description="The Deep Dives syllabus: 11 modules over 66 weeks, from LLM applications and data foundations to fine-tuning, multi-agent systems, recommendation systems and architect leadership.">
	<header class="page-head">
		<p class="eyebrow"><a href="/deep-dives/">Deep Dives</a> · Curriculum</p>
		<h1>The curriculum</h1>
		<p>
			Deep Dives follow a syllabus. Each week has one theme: Monday teaches it as a building block, Tuesday reads the research, Wednesday
			designs an enterprise system around it, Thursday turns it into an interview question, and Saturday builds it. Friday covers the GitHub
			repo everyone is talking about, and Sunday's Lab builds a language model step by step. Every sixth week is a review.
		</p>
		<div class="progress-row" aria-label={`Week ${currentWeek} of ${totalWeeks}`}>
			<span class="pr-bar"><span style={`width:${progress}%`}></span></span>
			<span class="pr-text">Week {currentWeek} of {totalWeeks}</span>
		</div>
	</header>

	<div class="modules">
		{
			modules.map((m) => {
				const ms = moduleState(m);
				return (
					<details class:list={['module', ms]} open={ms === 'now'}>
						<summary>
							<span class="m-id">{m.id}</span>
							<span class="m-name">{m.name}</span>
							<span class="m-meta">
								{m.phase} · weeks {m.weeks[0].week}–{m.weeks[m.weeks.length - 1].week}
								{ms === 'now' && <span class="badge">Now</span>}
								{ms === 'past' && <span class="badge done">Done</span>}
							</span>
						</summary>
						{m.note && <p class="m-note">{m.note}</p>}
						<ol class="weeks">
							{m.weeks.map((w) => {
								const posts = postsIn(w.week);
								return (
									<li class:list={['wk', state(w.week), { review: w.review }]}>
										<div class="wk-when">
											<span class="wk-n">Week {w.week}</span>
											<span class="wk-date">{fmt(w.start)}</span>
										</div>
										<div class="wk-body">
											<p class="wk-theme">
												{w.review ? 'Review: recap, self-test and Learning Radar' : (w.theme ?? w.done)}
												{state(w.week) === 'now' && <span class="badge">This week</span>}
											</p>
											{w.use_case && <p class="wk-case">Design: {w.use_case}</p>}
											{w.objectives && state(w.week) !== 'past' && (
												<ul class="wk-obj">
													{w.objectives.map((o) => (
														<li>{o}</li>
													))}
												</ul>
											)}
											{posts.length > 0 && (
												<ul class="wk-posts">
													{posts.map((p) => (
														<li data-track={p.data.track}>
															<a href={diveUrl(p)} title={p.data.title}>
																<TrackIcon track={p.data.track} size={13} />
																{getTrack(p.data.track).label}
															</a>
														</li>
													))}
												</ul>
											)}
										</div>
									</li>
								);
							})}
						</ol>
					</details>
				);
			})
		}
	</div>
</Base>

<style>
	.page-head .eyebrow a {
		color: inherit;
		text-decoration: none;
	}
	.progress-row {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-top: 1rem;
	}
	.pr-bar {
		flex: 1;
		height: 8px;
		border-radius: 99px;
		background: var(--surface-2);
		overflow: hidden;
	}
	.pr-bar span {
		display: block;
		height: 100%;
		background: var(--accent);
	}
	.pr-text {
		font-size: 0.85rem;
		color: var(--muted);
		white-space: nowrap;
	}
	.modules {
		max-width: var(--measure);
		margin: 0 auto;
		display: grid;
		gap: 0.7rem;
	}
	.module {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.module.now {
		border-color: var(--accent);
	}
	.module summary {
		cursor: pointer;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.1rem 0.8rem;
		padding: 0.9rem 1.1rem;
		list-style: none;
	}
	.module summary::-webkit-details-marker {
		display: none;
	}
	.m-id {
		grid-row: span 2;
		font-family: var(--font-head);
		font-weight: 800;
		color: var(--accent);
		font-size: 1.1rem;
		padding-top: 0.1rem;
	}
	.m-name {
		font-family: var(--font-head);
		font-weight: 700;
		font-size: 1.05rem;
	}
	.m-meta {
		font-size: 0.82rem;
		color: var(--muted);
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}
	.badge {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.1rem 0.45rem;
		border-radius: 99px;
		background: var(--accent-soft);
		color: var(--accent);
		margin-left: 0.4rem;
	}
	.badge.done {
		background: var(--surface-2);
		color: var(--muted);
	}
	.m-note {
		margin: 0 1.1rem 0.6rem;
		font-size: 0.9rem;
		color: var(--muted);
	}
	.weeks {
		list-style: none;
		margin: 0;
		padding: 0 1.1rem 0.6rem;
	}
	.wk {
		display: grid;
		grid-template-columns: 6rem 1fr;
		gap: 0.8rem;
		padding: 0.75rem 0;
		border-top: 1px solid var(--border);
	}
	.wk.now {
		background: var(--accent-soft);
		margin: 0 -1.1rem;
		padding: 0.75rem 1.1rem;
	}
	.wk-when {
		display: flex;
		flex-direction: column;
		font-size: 0.8rem;
		color: var(--muted);
	}
	.wk-n {
		font-weight: 700;
		color: var(--text);
	}
	.wk-theme {
		margin: 0;
		font-weight: 700;
		line-height: 1.35;
	}
	.wk.review .wk-theme {
		font-weight: 400;
		color: var(--muted);
		font-style: italic;
	}
	.wk.past .wk-theme {
		color: var(--muted);
	}
	.wk-case {
		margin: 0.2rem 0 0;
		font-size: 0.88rem;
		color: var(--muted);
	}
	.wk-obj {
		margin: 0.4rem 0 0;
		padding-left: 1.1rem;
		font-size: 0.88rem;
	}
	.wk-obj li {
		margin-bottom: 0.15rem;
	}
	.wk-posts {
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.wk-posts a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.78rem;
		padding: 0.2rem 0.55rem;
		border-radius: 99px;
		background: var(--track-soft);
		color: var(--track);
		text-decoration: none;
		font-weight: 600;
	}
	@media (max-width: 520px) {
		.wk {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
		.wk-when {
			flex-direction: row;
			gap: 0.5rem;
		}
	}
</style>
