// Cloudflare Workers config. Serves the static site Astro builds into dist/.
// `previews` lets non-production branches deploy a preview with `npx wrangler preview`.
{
	"name": "thevoyager-dev",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"previews": {}
}
