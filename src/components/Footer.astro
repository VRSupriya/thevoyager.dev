---
import { LINKS, SITE_NAME } from '../consts';
import SignupForm from './SignupForm.astro';

interface Props {
	showNewsletter?: boolean;
}
const { showNewsletter = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		{
			showNewsletter && (
				<div class="signup">
					<p>
						<strong>The weekly note.</strong> My own writing, once a week. Never the daily AI digests.
					</p>
					<SignupForm id="footer-email" />
				</div>
			)
		}
		<div class="bottom">
			<p>© {year} {SITE_NAME}</p>
			<nav aria-label="Footer">
				<a href="/start/">Start here</a>
				<a href={LINKS.github}>GitHub</a>
				{LINKS.linkedin && <a href={LINKS.linkedin}>LinkedIn</a>}
				<a href={LINKS.substack}>Substack</a>
				<a href="/brief/rss.xml">RSS</a>
				<a href="/contact/">Contact</a>
				<a href="/privacy/">Privacy</a>
				<a href="/disclosure/">Disclosure</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		padding: 2rem 0 2.5rem;
		font-size: 0.9rem;
		color: var(--muted);
	}
	.signup {
		display: grid;
		gap: 0.9rem;
		align-items: center;
		padding-bottom: 1.6rem;
		margin-bottom: 1.4rem;
		border-bottom: 1px solid var(--border);
	}
	.signup p {
		margin: 0;
	}
	.signup strong {
		color: var(--text);
	}
	@media (min-width: 800px) {
		.signup {
			grid-template-columns: 1fr minmax(0, 28rem);
		}
	}
	.bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.6rem 1.5rem;
	}
	.bottom p {
		margin: 0;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--text);
	}
</style>
