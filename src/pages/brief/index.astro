---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { briefStories } from '../../lib/brief';
import { briefUrl, getBriefs } from '../../lib/posts';

const posts = await getBriefs();
const rows = posts.map((p) => {
	const stories = briefStories(p.body, p.data.telegram);
	return { p, stories, weekday: p.data.date.toLocaleDateString('en-GB', { weekday: 'short', timeZone: 'UTC' }) };
});
---

<Base title="Daily Brief" description="The AI Daily Brief: the few things worth knowing in AI, cloud and systems each morning.">
	<header class="page-head">
		<p class="eyebrow">Daily Brief</p>
		<h1>The AI Daily Brief</h1>
		<p>
			Each morning, the handful of things in AI, cloud and systems that are worth your time. <a href="/brief/rss.xml">RSS</a>.
		</p>
	</header>
	{
		rows.length ? (
			<ol class="brief-list">
				{rows.map(({ p, stories, weekday }) => (
					<li>
						<article class="brief-row">
							<div class="br-date">
								<span class="br-wd">{weekday}</span>
								<FormattedDate date={p.data.date} />
							</div>
							<div class="br-main">
								<h2>
									<a href={briefUrl(p)}>{p.data.title}</a>
								</h2>
								<p>{p.data.summary}</p>
								<div class="meta">
									<span>{stories.length} {stories.length === 1 ? 'story' : 'stories'}</span>
									<span class="br-slots" aria-hidden="true">
										{stories.map((s) => (
											<i class={`slot-${s.key}`} title={s.label} />
										))}
									</span>
								</div>
							</div>
						</article>
					</li>
				))}
			</ol>
		) : (
			<p class="empty">The first brief lands soon.</p>
		)
	}
</Base>

<style>
	.brief-list {
		list-style: none;
		margin: 0 auto;
		padding: 0;
		max-width: var(--measure);
	}
	.brief-row {
		position: relative;
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: 1rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--border);
	}
	.br-date {
		display: flex;
		flex-direction: column;
		font-size: 0.85rem;
		color: var(--muted);
		padding-top: 0.2rem;
	}
	.br-wd {
		font-family: var(--font-head);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.75rem;
		color: var(--accent);
	}
	h2 {
		font-size: 1.15rem;
		line-height: 1.3;
		margin: 0 0 0.3rem;
	}
	h2 a {
		color: var(--text);
		text-decoration: none;
	}
	h2 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.brief-row:hover h2 a {
		color: var(--accent);
	}
	.br-main p {
		margin: 0 0 0.4rem;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.br-slots {
		display: inline-flex;
		gap: 4px;
	}
	.br-slots i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--slot, var(--accent));
	}
	@media (max-width: 520px) {
		.brief-row {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}
		.br-date {
			flex-direction: row;
			gap: 0.5rem;
		}
	}
</style>
