---
import Base from '../../layouts/Base.astro';
import DiveCard from '../../components/DiveCard.astro';
import TrackTabs from '../../components/TrackTabs.astro';
import { getDives } from '../../lib/posts';

const posts = await getDives();
const counts: Record<string, number> = {};
for (const p of posts) counts[p.data.track] = (counts[p.data.track] ?? 0) + 1;
---

<Base title="Deep Dives" description="Deep Dives: one topic a day, explained properly, across models and agents, research, system design, interviews, open-source projects, builds and an LLM architecture lab.">
	<header class="page-head">
		<p class="eyebrow">Deep Dives</p>
		<h1>Deep Dives</h1>
		<p>
			One topic a day, explained properly: models and agents, research, system design, interviews, open-source projects, weekend builds and an LLM architecture lab. <a href="/deep-dives/rss.xml">RSS</a>.
		</p>
	</header>
	<TrackTabs counts={counts} total={posts.length} />
	{
		posts.length ? (
			<ul class="card-grid">
				{posts.map((p) => (
					<li>
						<DiveCard post={p} headingLevel="h2" />
					</li>
				))}
			</ul>
		) : (
			<p class="empty">The first deep dive lands soon.</p>
		)
	}
</Base>
